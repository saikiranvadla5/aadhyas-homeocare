# .env.example
# Copy this file to .env and fill in the actual values.

# PostgreSQL connection string (e.g., postgres://user:password@localhost:5432/dbname)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# NextAuth configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<random-secret>"

# Admin credentials (initial placeholder – change password after first login)
ADMIN_EMAIL="saikiranvadla5@gmail.com"
# bcrypt hash for a temporary password (e.g., 'ChangeMe123!') – you can replace after login
ADMIN_PASSWORD_HASH="$2a$10$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# reCAPTCHA provider (options: none, recaptcha_v2, recaptcha_v3, turnstile)
RECAPTCHA_PROVIDER="none"
# reCAPTCHA site key (if enabled)
RECAPTCHA_SITE_KEY=""
# reCAPTCHA secret key (if enabled)
RECAPTCHA_SECRET_KEY=""

